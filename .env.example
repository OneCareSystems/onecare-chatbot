DB_NAME=onecare_chatbot
DB_USER=chatbot_app
DB_PASSWORD=chatbot_dev_pw
DB_HOST=127.0.0.1
DB_PORT=3307
# Docker MySQL host port (the chatbot container uses db:3306 internally).
MYSQL_HOST_PORT=3307

DJANGO_SECRET_KEY=<python -c "import secrets;print(secrets.token_urlsafe(48))">
DJANGO_DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,chatbot
CORS_ALLOWED_ORIGINS=

MAIN_DB_USER=<Spring Boot's DB user>     # optional guard: chatbot must not use this user

# Spring Boot -> Django authentication (at least 32 characters)
CHATBOT_SERVICE_TOKEN=<python -c "import secrets;print(secrets.token_urlsafe(48))">

# FAISS index + uploaded PDFs live here, never inside the Spring Boot app
CHATBOT_STORAGE_DIR=

# ---- tests / verification on your machine ONLY, never in deployed environments ----
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MAIN_DB_NAME=onecare
SPRING_SCHEMA=onecare
SPRING_TABLE=<one real table in onecare>

CHATBOT_DJANGO_SECRET_KEY=<python -c "import secrets;print(secrets.token_urlsafe(48))">
